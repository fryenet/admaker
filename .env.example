# Copy this file to .env and add your own service credentials.

ELEVENLABS_API_KEY=your_elevenlabs_key
BFL_API_KEY=your_black_forest_labs_key
OPENAI_API_KEY=your_openai_key
PIAPI_API_KEY=your_piapi_key
XAI_API_KEY=your_xai_key

# Public asset hosting used by the video-generation workflow.
PUBLIC_DATA_DIR=/var/www/html/youradsmith/data
PUBLIC_BASE_URL=https://youradsmith.com/data
